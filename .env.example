# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# ---- language model (Groq is the only provider; server-side only) ----
GROQ_API_KEY=
# Optional override of llm.model in configs/config.yaml (must be a chat model your key can use)
GROQ_MODEL=

# ---- literature (optional) ----
NCBI_API_KEY=
NCBI_EMAIL=

# ---- environment ----
# development (default) | production. Production refuses to start without DATABASE_URL and a non-localhost CORS_ALLOW_ORIGINS,
# disables /docs and /openapi.json, and sends HSTS (terminate TLS at your proxy/platform).
APP_ENV=development

# ---- database ----
# Local development default: sqlite:///data/app.db. Deployment: PostgreSQL, e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# (use postgresql+pg8000:// for the pure-Python driver). Keep credentials out of source control.
DATABASE_URL=
# 1 = apply Alembic migrations at startup (default in development); 0 = run `alembic upgrade head` yourself (default in production)
AUTO_MIGRATE=
# Retention: delete cases/drafts (and their scenarios/reports) not updated for N days; 0 disables
RETENTION_DAYS=0
POSTGRES_PASSWORD=

# ---- authentication ----
ALLOW_REGISTRATION=1
ACCESS_TOKEN_TTL_MIN=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_MINUTES=15

# ---- API protection (limits are per process / per client IP) ----
# Comma-separated trusted browser origins (no wildcard). Default (development only): http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=
MAX_BODY_BYTES=262144
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_LLM_PER_MIN=30
AUTH_RATE_LIMIT_PER_MIN=10
